<Window x:Class="Parrot.App.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Parrot.App.Views"
        Title="Parrot — статистика"
        Width="900" Height="720"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface}">

    <Window.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Corner.Card}" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="Tile.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>

        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="14,12"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Оновити" Click="OnRefresh" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Width="26" Height="26" />
                    <TextBlock Text="Статистика" Style="{StaticResource Text.Heading}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,18,20,24">

                <TextBlock x:Name="EmptyHint" Visibility="Collapsed" Margin="0,0,0,16"
                           Style="{StaticResource Text.Muted}" FontSize="13" TextWrapping="Wrap"
                           Text="Відповідей ще немає — цифри з'являться, щойно Parrot покаже перші картки. Можна не чекати: «Показати картку зараз» у меню трею." />

                <!-- Tiles -->
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Tile}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Серія днів" Style="{StaticResource Text.Muted}" />
                            <TextBlock x:Name="StreakValue" Style="{StaticResource Tile.Value}" />
                            <TextBlock x:Name="StreakNote" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="Точність · 7 днів" Style="{StaticResource Text.Muted}" />
                            <TextBlock x:Name="Accuracy7Value" Style="{StaticResource Tile.Value}" />
                            <TextBlock x:Name="Accuracy7Note" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="Точність · 30 днів" Style="{StaticResource Text.Muted}" />
                            <TextBlock x:Name="Accuracy30Value" Style="{StaticResource Tile.Value}" />
                            <TextBlock x:Name="Accuracy30Note" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Вивчено" Style="{StaticResource Text.Muted}" />
                            <TextBlock x:Name="LearnedValue" Style="{StaticResource Tile.Value}" />
                            <TextBlock x:Name="LearnedNote" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Daily activity -->
                <Border Style="{StaticResource Tile}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Success}" />
                                <TextBlock Text="правильно" Style="{StaticResource Text.Muted}" Margin="5,0,12,0" />
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Danger}" />
                                <TextBlock Text="помилка" Style="{StaticResource Text.Muted}" Margin="5,0,12,0" />
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Border}" />
                                <TextBlock Text="пропущено" Style="{StaticResource Text.Muted}" Margin="5,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Активність за 30 днів" Style="{StaticResource Section}" />
                        </DockPanel>

                        <ItemsControl x:Name="DailyChart" Height="150">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ToolTip}" Background="Transparent" Margin="2,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Border Height="{Binding IgnoredHeight}" Background="{DynamicResource Brush.Border}" CornerRadius="2,2,0,0" />
                                            <Border Height="{Binding MissedHeight}" Background="{DynamicResource Brush.Danger}" />
                                            <Border Height="{Binding CorrectHeight}" Background="{DynamicResource Brush.Success}" />
                                        </StackPanel>
                                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                                Background="{DynamicResource Brush.Border}" />
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" Style="{StaticResource Text.Muted}"
                                                   FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TodayNote" Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Difficulty and hardest cards -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="Складність карток" Style="{StaticResource Section}" />

                            <ItemsControl x:Name="DifficultyList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10" ToolTip="{Binding ToolTip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" Height="10" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Brush.SurfaceSunk}" CornerRadius="5" />
                                                <Border HorizontalAlignment="Left" CornerRadius="5"
                                                        Background="{Binding Brush}">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{x:Static local:Fraction.Converter}">
                                                            <Binding Path="Share" />
                                                            <Binding Path="ActualWidth"
                                                                     RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="13"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="DifficultyNote" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="Найважчі картки" Style="{StaticResource Section}" />

                            <TextBlock x:Name="HardestEmpty" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                       Text="Поки жодної помилки — тут з'являться картки, які даються найважче."
                                       Visibility="Collapsed" />

                            <ItemsControl x:Name="HardestList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Front}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Back}" Style="{StaticResource Text.Muted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Difficulty}" FontSize="13" HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource Brush.Danger}" />
                                                <TextBlock Text="{Binding Accuracy}" Style="{StaticResource Text.Muted}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
