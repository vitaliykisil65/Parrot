<Window x:Class="Parrot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Parrot.App.Localization"
        xmlns:c="clr-namespace:Parrot.App.Controls"
        Title="Parrot"
        Width="1200" Height="760"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="14"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource Brush.Window}">

    <WindowChrome.WindowChrome>
        <!-- A 1px glass frame keeps the native drop shadow and snap behaviour. -->
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderThickness="1" BorderBrush="{DynamicResource Brush.WindowBorder}"
            Background="{DynamicResource Brush.Window}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Sidebar ═══════════════════════════════════════════════════ -->
            <DockPanel Grid.Column="0" Margin="12,10,12,12">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Margin="8,0,0,0">
                    <Image x:Name="LogoImage" Width="30" Height="30" VerticalAlignment="Center" />
                    <TextBlock Text="Parrot" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Display}" FontSize="17" FontWeight="Bold" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,18,0,0">
                    <RadioButton x:Name="NavDictionary" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="{l:T Nav.Dictionary}" c:Ui.Icon="{StaticResource Icon.Book}"
                                 ToolTip="Ctrl+1" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavPractice" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,2,0,0"
                                 Content="{l:T Nav.Practice}" c:Ui.Icon="{StaticResource Icon.Cards}"
                                 ToolTip="Ctrl+2" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavStatistics" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,2,0,0"
                                 Content="{l:T Nav.Statistics}" c:Ui.Icon="{StaticResource Icon.Chart}"
                                 ToolTip="Ctrl+3" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,2,0,0"
                                 Content="{l:T Nav.Settings}" c:Ui.Icon="{StaticResource Icon.Sliders}"
                                 ToolTip="Ctrl+4" Checked="OnNavChecked" />
                </StackPanel>

                <!-- New version: docked first, so it sits at the very bottom, under the streak -->
                <Border x:Name="UpdateCard" DockPanel.Dock="Bottom" Style="{StaticResource Card}" CornerRadius="14"
                        Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid>
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="UpdateIconBox" Width="34" Height="34" CornerRadius="10"
                                        Background="{DynamicResource Brush.Primary}">
                                    <c:Icon x:Name="UpdateIcon" Data="{StaticResource Icon.Download}" Size="18"
                                            Foreground="{DynamicResource Brush.PrimaryText}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel x:Name="UpdateText" Margin="10,0,24,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="UpdateNote" Style="{StaticResource Text.Caption}" FontWeight="Normal"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="UpdateLinkText" FontSize="12" Cursor="Hand"
                                               Foreground="{DynamicResource Brush.Info}"
                                               Text="{l:T Update.WhatsNew}" MouseLeftButtonUp="OnUpdateNotes" />
                                </StackPanel>
                            </DockPanel>

                            <Grid x:Name="UpdateTrack" Height="6" Margin="0,12,0,0" ClipToBounds="True"
                                  Visibility="Collapsed" SizeChanged="OnUpdateTrackSizeChanged">
                                <Border CornerRadius="3" Background="{DynamicResource Brush.Track}" />
                                <Border x:Name="UpdateFill" CornerRadius="3" HorizontalAlignment="Left" Width="0"
                                        Background="{DynamicResource Brush.Info}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="UpdateFillShift" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <Button x:Name="UpdateButton" Style="{StaticResource Button.Primary}" Margin="0,12,0,0"
                                    MinHeight="36" FontSize="13" HorizontalAlignment="Stretch" Click="OnUpdateAction" />
                        </StackPanel>

                        <Button x:Name="UpdateClose" Style="{StaticResource Button.IconGhost}" Width="24" Height="24"
                                c:Ui.IconSize="12" c:Ui.Icon="{StaticResource Icon.Close}" ToolTip="{l:T Update.Later}"
                                AutomationProperties.Name="{l:T Update.Later}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                Click="OnUpdateDismiss" />
                    </Grid>
                </Border>

                <!-- Streak and schedule -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" CornerRadius="14" Padding="14">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.Active}">
                                <c:Icon Data="{StaticResource Icon.Flame}" Size="18"
                                        Foreground="{DynamicResource Brush.ActiveIcon}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StreakText" FontWeight="SemiBold" />
                                <TextBlock x:Name="StreakNote" Style="{StaticResource Text.Caption}" FontWeight="Normal" />
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid x:Name="StreakDays" Rows="1" Margin="0,12,0,0" />

                        <Border Height="1" Margin="0,12" Background="{DynamicResource Brush.Line}" />

                        <DockPanel>
                            <Button x:Name="PauseButton" DockPanel.Dock="Right" Style="{StaticResource Button.Icon}"
                                    Width="34" Height="34" MinHeight="0"
                                    c:Ui.Icon="{StaticResource Icon.Pause}" Click="OnPauseClick" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NextLabel" Style="{StaticResource Text.Caption}" FontWeight="Normal"
                                           Text="{l:T Sidebar.NextCard}" />
                                <TextBlock x:Name="NextText" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </DockPanel>

                        <Button Style="{StaticResource Button.Soft}" Margin="0,12,0,0" MinHeight="36" FontSize="13"
                                HorizontalAlignment="Stretch" Content="{l:T Sidebar.ShowNow}"
                                c:Ui.Icon="{StaticResource Icon.Play}" c:Ui.IconSize="12"
                                Click="OnPromptNow" />
                    </StackPanel>
                </Border>

                <!-- Decks -->
                <DockPanel Margin="0,26,0,12">
                    <TextBlock DockPanel.Dock="Top" Text="{l:T Sidebar.Decks}" Style="{StaticResource Text.Caption}"
                               FontWeight="SemiBold" Margin="12,0,0,6" />

                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBox x:Name="DeckNameBox" Visibility="Collapsed" Margin="0,4,0,0" MinHeight="34"
                                 c:Ui.Hint="{l:T Sidebar.DeckNameHint}"
                                 KeyDown="OnDeckNameKeyDown" LostKeyboardFocus="OnDeckNameLostFocus" />
                        <Button x:Name="NewDeckButton" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" MinHeight="36" Padding="10,0" FontWeight="Normal"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Content="{l:T Sidebar.NewDeck}" c:Ui.Icon="{StaticResource Icon.Plus}"
                                Click="OnNewDeck" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                        <StackPanel x:Name="DeckList" />
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>

            <!-- ═══ Content ═══════════════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Caption}" ToolTip="{l:T Window.Minimize}"
                            c:Ui.Icon="{StaticResource Icon.Minus}" Click="OnMinimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" ToolTip="{l:T Window.Maximize}"
                            c:Ui.Icon="{StaticResource Icon.Maximize}" c:Ui.IconSize="13" Click="OnMaximize" />
                    <Button Style="{StaticResource Button.CaptionClose}" ToolTip="{l:T Window.Close}"
                            c:Ui.Icon="{StaticResource Icon.Close}" Click="OnClose" />
                </StackPanel>

                <Border x:Name="Panel" Grid.Row="1" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,1,0,0"
                        CornerRadius="14,0,0,0">
                    <Grid>
                        <ContentControl x:Name="PageHost" Focusable="False" />

                        <!-- Toast -->
                        <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,24" Padding="16,8,8,8" CornerRadius="12"
                                Background="{DynamicResource Brush.Toast}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.2" Color="#14202E" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource Brush.ToastText}" MaxWidth="460" TextWrapping="Wrap" />
                                <Button x:Name="ToastAction" Style="{StaticResource Button.Primary}" MinHeight="30"
                                        Padding="12,0" Margin="14,0,0,0" FontSize="13" Click="OnToastAction" />
                                <Button Style="{StaticResource Button.IconGhost}" Margin="6,0,0,0"
                                        Foreground="{DynamicResource Brush.ToastText}"
                                        c:Ui.Icon="{StaticResource Icon.Close}" ToolTip="{l:T Common.Hide}" Click="OnToastClose" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ Dialog layer ══════════════════════════════════════════════ -->
            <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed"
                  Background="{DynamicResource Brush.Scrim}">
                <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource Card}" Padding="24,22">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.25" Color="#14202E" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="DialogTitle" Style="{StaticResource Text.Section}" FontSize="17" TextWrapping="Wrap" />
                        <TextBlock x:Name="DialogMessage" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" LineHeight="20" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button x:Name="DialogCancel" Content="{l:T Common.Cancel}" Click="OnDialogCancel" />
                            <Button x:Name="DialogConfirm" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"
                                    Click="OnDialogConfirm" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
