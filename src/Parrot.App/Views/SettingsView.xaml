<UserControl x:Class="Parrot.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Parrot.App.Localization"
             xmlns:c="clr-namespace:Parrot.App.Controls">

    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,14,18,4" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SectionIcon" TargetType="c:Icon">
            <Setter Property="Size" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
        </Style>

        <!-- Row: title (+ optional note) on the left, control on the right, a hairline on top. -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="RowText" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,10,16,10" />
        </Style>

        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MaxLength" Value="5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,12">

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:T Settings.Defaults}" VerticalAlignment="Center"
                        FontSize="13" Click="OnResetDefaults" />
                <StackPanel>
                    <TextBlock Text="{l:T Nav.Settings}" Style="{StaticResource Text.Title}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0" Text="{l:T Settings.Subtitle}" />
                </StackPanel>
            </DockPanel>

            <Border x:Name="ErrorBar" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="10" Padding="14,9"
                    Background="{DynamicResource Brush.DangerSoft}">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="13" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═══ Left column ═══════════════════════════════════════════ -->
                <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionTitle}">
                                <c:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource Icon.Clock}" />
                                <TextBlock Text="{l:T Settings.Frequency}" Style="{StaticResource Text.Section}" />
                            </StackPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <c:NumberStepper x:Name="IntervalStepper" DockPanel.Dock="Right" Minimum="1" Maximum="480"
                                                 Step="5" Suffix="{l:T Unit.Minutes}" ValueCommitted="OnIntervalChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Interval}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.IntervalNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="JitterSlider" Width="110" Minimum="0" Maximum="90" SmallChange="5"
                                            LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="OnJitterMoved" />
                                    <TextBlock x:Name="JitterText" Width="46" TextAlignment="Right" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Jitter}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.JitterNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <c:NumberStepper x:Name="DisplayStepper" DockPanel.Dock="Right" Minimum="0" Maximum="600"
                                                 Step="5" Suffix="{l:T Unit.Seconds}" ZeroText="{l:T Settings.NoRush}" ValueCommitted="OnDisplayChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Display}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.DisplayNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <c:NumberStepper x:Name="NewCardsStepper" DockPanel.Dock="Right" Minimum="0" Maximum="200"
                                                 Step="1" ValueCommitted="OnNewCardsChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.NewCards}" Style="{StaticResource RowTitle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <c:NumberStepper x:Name="MaxPromptsStepper" DockPanel.Dock="Right" Minimum="0" Maximum="1000"
                                                 Step="5" ZeroText="{l:T Settings.NoLimit}" ValueCommitted="OnMaxPromptsChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.MaxPrompts}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.MaxPromptsNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <c:NumberStepper x:Name="CooldownStepper" DockPanel.Dock="Right" Minimum="1" Maximum="240"
                                                 Step="5" Suffix="{l:T Unit.Minutes}" ValueCommitted="OnCooldownChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Cooldown}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.CooldownNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="AlwaysShowSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          Click="OnAlwaysShowChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.AlwaysShow}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.AlwaysShowNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionTitle}">
                                <c:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource Icon.Moon}" />
                                <TextBlock Text="{l:T Settings.Quiet}" Style="{StaticResource Text.Section}" />
                            </StackPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="QuietFromBox" Style="{StaticResource TimeBox}"
                                             LostKeyboardFocus="OnQuietTimeCommitted" KeyDown="OnTimeKeyDown" />
                                    <TextBlock Text="—" Margin="6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                    <TextBox x:Name="QuietToBox" Style="{StaticResource TimeBox}"
                                             LostKeyboardFocus="OnQuietTimeCommitted" KeyDown="OnTimeKeyDown" />
                                    <CheckBox x:Name="QuietSwitch" Style="{StaticResource Switch}" Margin="14,0,0,0"
                                              Click="OnQuietChanged" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.QuietHours}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.QuietHoursNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel x:Name="DaysPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Days}" Style="{StaticResource RowTitle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <c:NumberStepper x:Name="IdleStepper" DockPanel.Dock="Right" Minimum="0" Maximum="120"
                                                 Step="1" Suffix="{l:T Unit.Minutes}" ZeroText="{l:T Settings.Off}" ValueCommitted="OnIdleChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Idle}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.IdleNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="FullscreenSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          Click="OnFullscreenChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Fullscreen}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.FullscreenNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Right column ══════════════════════════════════════════ -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource SectionCard}" Padding="18,14,18,4">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionTitle}" Margin="0,0,0,14">
                                <c:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource Icon.Monitor}" />
                                <TextBlock Text="{l:T Settings.Position}" Style="{StaticResource Text.Section}" />
                            </StackPanel>

                            <DockPanel Margin="0,0,0,14">
                                <!-- Miniature screen with the nine anchor points. -->
                                <Border DockPanel.Dock="Left" Width="200" Height="128" CornerRadius="12" BorderThickness="2"
                                        BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.SurfaceAlt}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Bottom" Height="8" CornerRadius="0,0,10,10"
                                                Background="{DynamicResource Brush.Line}" />
                                        <UniformGrid x:Name="AnchorGrid" Rows="3" Columns="3" Margin="8,8,8,6" />
                                    </DockPanel>
                                </Border>

                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{l:T Settings.MonitorAndMargins}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="MonitorBox" DisplayMemberPath="Label" SelectionChanged="OnMonitorChanged" />

                                    <DockPanel Margin="0,12,0,0">
                                        <c:NumberStepper x:Name="MarginXStepper" DockPanel.Dock="Right" Minimum="0" Maximum="400"
                                                         Step="4" Suffix="px" ValueCommitted="OnMarginChanged" />
                                        <TextBlock Text="↔" Style="{StaticResource Text.Muted}" FontSize="16" VerticalAlignment="Center" ToolTip="{l:T Settings.MarginX}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <c:NumberStepper x:Name="MarginYStepper" DockPanel.Dock="Right" Minimum="0" Maximum="400"
                                                         Step="4" Suffix="px" ValueCommitted="OnMarginChanged" />
                                        <TextBlock Text="↕" Style="{StaticResource Text.Muted}" FontSize="16" VerticalAlignment="Center" ToolTip="{l:T Settings.MarginY}" />
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="FocusSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          Click="OnFocusChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Focus}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.FocusNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionTitle}">
                                <c:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource Icon.Book}" />
                                <TextBlock Text="{l:T Settings.Learning}" Style="{StaticResource Text.Section}" />
                            </StackPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}">
                                    <StackPanel x:Name="DirectionPanel" Orientation="Horizontal" />
                                </Border>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Direction}" Style="{StaticResource RowTitle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}">
                                    <StackPanel x:Name="StrictnessPanel" Orientation="Horizontal" />
                                </Border>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Strictness}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.StrictnessNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionTitle}">
                                <c:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource Icon.Window}" />
                                <TextBlock Text="{l:T Settings.System}" Style="{StaticResource Text.Section}" />
                            </StackPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="150" VerticalAlignment="Center"
                                          DisplayMemberPath="NativeName" SelectionChanged="OnLanguageChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Language}" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="LanguageNote" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}">
                                    <StackPanel x:Name="ThemePanel" Orientation="Horizontal" />
                                </Border>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Theme}" Style="{StaticResource RowTitle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.IconGhost}" Margin="0,0,10,0"
                                            c:Ui.Icon="{StaticResource Icon.Volume}" ToolTip="{l:T Settings.Listen}" Click="OnPreviewSound" />
                                    <CheckBox x:Name="SoundSwitch" Style="{StaticResource Switch}" Click="OnSoundChanged" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.Sound}" Style="{StaticResource RowTitle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="AutoStartSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          Click="OnAutoStartChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.AutoStart}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.AutoStartNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                        MinHeight="34" FontSize="13" Content="{l:T Settings.CheckUpdates}"
                                        Click="OnCheckUpdates" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource RowRule}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="AutoUpdateSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          Click="OnAutoUpdateChanged" />
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Text="{l:T Settings.AutoUpdate}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:T Settings.AutoUpdateNote}" Style="{StaticResource RowNote}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="DataPathText" Style="{StaticResource Text.Caption}" FontWeight="Normal"
                               TextWrapping="Wrap" Margin="4,0,0,12" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
