<Window x:Class="Parrot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parrot — налаштування"
        Width="600" Height="720"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface}">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}">
            <Setter Property="Margin" Value="0,22,0,10" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Muted}"
                           Foreground="{DynamicResource Brush.Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Скасувати" IsCancel="True" Click="OnCancel" />
                    <Button Content="Зберегти" Style="{StaticResource Button.Primary}"
                            Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,18">
            <StackPanel>

                <TextBlock Text="Частота показу" Style="{StaticResource Section}" Margin="0,14,0,10" />

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Інтервал, хвилин" />
                        <TextBox x:Name="IntervalBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Розкид інтервалу, %" />
                        <TextBox x:Name="JitterBox" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Час показу, секунд (0 — поки не відповім)" />
                        <TextBox x:Name="DisplaySecondsBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Пауза після ігнорування, хвилин" />
                        <TextBox x:Name="CooldownBox" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Максимум показів на день (0 — без ліміту)" />
                        <TextBox x:Name="MaxPromptsBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Нових карток на день" />
                        <TextBox x:Name="MaxNewBox" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="AlwaysShowBox" Content="Показувати найближчу картку, навіть якщо жодна ще не на черзі" />

                <TextBlock Text="Коли мовчати" Style="{StaticResource Section}" />

                <CheckBox x:Name="QuietEnabledBox" Content="Тихі години" />

                <Grid Style="{StaticResource FieldRow}" Margin="0,8,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Від (ГГ:ХХ)" />
                        <TextBox x:Name="QuietFromBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="До (ГГ:ХХ)" />
                        <TextBox x:Name="QuietToBox" />
                    </StackPanel>
                </Grid>

                <Label Content="Дні тижня" />
                <WrapPanel x:Name="DaysPanel" Margin="0,2,0,10" />

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Не питати, якщо мене немає, хвилин (0 — вимкнено)" />
                        <TextBox x:Name="IdleBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <CheckBox x:Name="FullscreenBox" Content="Не заважати в повноекранних програмах" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Де з'являється вікно" Style="{StaticResource Section}" />

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Позиція" />
                        <ComboBox x:Name="AnchorBox" DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Монітор" />
                        <ComboBox x:Name="MonitorBox" DisplayMemberPath="Label" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Відступ по горизонталі, px" />
                        <TextBox x:Name="MarginXBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Відступ по вертикалі, px" />
                        <TextBox x:Name="MarginYBox" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="FocusInputBox" Content="Одразу ставити курсор у поле відповіді" />
                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="24,2,0,0"
                           Text="Вимкнено — вікно не перехоплює фокус і не заважає друкувати в інших програмах." />

                <TextBlock Text="Навчання" Style="{StaticResource Section}" />

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Напрямок перекладу" />
                        <ComboBox x:Name="DirectionBox" DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Перевірка відповіді" />
                        <ComboBox x:Name="StrictnessBox" DisplayMemberPath="Label" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Система" Style="{StaticResource Section}" />

                <CheckBox x:Name="AutoStartBox" Content="Запускати разом із Windows" />
                <CheckBox x:Name="SoundBox" Content="Звук при появі картки" />

                <StackPanel Margin="0,10,0,0">
                    <Label Content="Тема" />
                    <ComboBox x:Name="ThemeBox" DisplayMemberPath="Label" Width="220" HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock x:Name="DataPathText" Style="{StaticResource Text.Muted}"
                           Margin="0,18,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
