<Window x:Class="Parrot.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Parrot.App.Localization"
        xmlns:c="clr-namespace:Parrot.App.Controls"
        Title="Parrot"
        Width="392"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="14"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal"
        FocusManager.FocusedElement="{x:Null}">

    <Window.RenderTransform>
        <TranslateTransform x:Name="SlideTransform" />
    </Window.RenderTransform>

    <!-- The margin leaves room for the shadow inside the transparent window. -->
    <Border Margin="16"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.2" Color="#14202E" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="16,12,10,0">
                <Button x:Name="DismissButton" DockPanel.Dock="Right" Style="{StaticResource Button.IconGhost}"
                        Width="28" Height="28" c:Ui.Icon="{StaticResource Icon.Close}" c:Ui.IconSize="14"
                        ToolTip="{l:T Prompt.Dismiss}"
                        Click="OnDismiss" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Width="22" Height="22" />
                    <TextBlock x:Name="DeckLabel" Style="{StaticResource Text.Caption}" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                </StackPanel>
            </DockPanel>

            <!-- Question and answer -->
            <StackPanel Grid.Row="1" Margin="16,10,16,16">
                <TextBlock x:Name="QuestionText" FontFamily="{StaticResource Font.Display}" FontSize="26"
                           FontWeight="SemiBold" TextWrapping="Wrap" />

                <TextBlock x:Name="HintText" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <TextBox x:Name="AnswerBox" Margin="0,14,0,0" MinHeight="42" FontSize="15"
                         c:Ui.Hint="{l:T Prompt.AnswerHint}"
                         KeyDown="OnAnswerKeyDown"
                         TextChanged="OnAnswerChanged" />

                <StackPanel x:Name="ActionPanel" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="CheckButton" Style="{StaticResource Button.Primary}" MinHeight="36"
                            Padding="14,0,10,0" Click="OnCheck">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T Prompt.Check}" />
                            <Border Style="{StaticResource Kbd.OnPrimary}"><TextBlock Text="Enter" /></Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DontKnowButton" Content="{l:T Prompt.DontKnow}" Margin="8,0,0,0" MinHeight="36"
                            Click="OnDontKnow" />
                </StackPanel>

                <!-- Result -->
                <Border x:Name="ResultPanel" Visibility="Collapsed" Margin="0,14,0,0" Padding="14,12" CornerRadius="12">
                    <DockPanel>
                        <Border x:Name="ResultBadge" DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13"
                                VerticalAlignment="Top" Margin="0,0,12,0">
                            <c:Icon x:Name="ResultIcon" Size="14" StrokeThickness="2.6"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="ResultStatus" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ResultYours" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <TextBlock x:Name="ResultAnswer" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ResultExample" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" FontStyle="Italic" Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DockPanel x:Name="ContinuePanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <Button x:Name="ContinueButton" DockPanel.Dock="Right" Style="{StaticResource Button.Primary}"
                            MinHeight="36" Padding="16,0,10,0" Click="OnContinue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T Prompt.Next}" />
                            <Border Style="{StaticResource Kbd.OnPrimary}"><TextBlock Text="Enter" /></Border>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="NextNote" Style="{StaticResource Text.Muted}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>

            <!-- Countdown -->
            <Border x:Name="CountdownTrack" Grid.Row="2" Height="3" Margin="16,0,16,10" CornerRadius="1.5"
                    Background="{DynamicResource Brush.Track}">
                <Rectangle x:Name="CountdownBar" HorizontalAlignment="Stretch" RadiusX="1.5" RadiusY="1.5"
                           Fill="{DynamicResource Brush.Primary}"
                           RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="CountdownScale" ScaleX="1" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>
    </Border>
</Window>
