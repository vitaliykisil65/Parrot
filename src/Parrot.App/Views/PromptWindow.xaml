<Window x:Class="Parrot.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parrot"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{x:Null}">

    <Window.RenderTransform>
        <TranslateTransform x:Name="SlideTransform" />
    </Window.RenderTransform>

    <Border Margin="14"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource Corner.Card}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="16,12,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Width="20" Height="20" />
                    <TextBlock x:Name="DeckLabel" Style="{StaticResource Text.Muted}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="DismissButton" Content="✕"
                        Style="{StaticResource Button.Subtle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="8,2" MinHeight="24" FontSize="12"
                        ToolTip="Пропустити (Esc) — на рейтинг не впливає"
                        Click="OnDismiss" />
            </Grid>

            <!-- Question and answer -->
            <StackPanel Grid.Row="1" Margin="16,10,16,14">
                <TextBlock x:Name="QuestionText" Style="{StaticResource Text.Prompt}" />

                <TextBlock x:Name="HintText" Style="{StaticResource Text.Muted}"
                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                <TextBox x:Name="AnswerBox" Margin="0,12,0,0"
                         KeyDown="OnAnswerKeyDown"
                         TextChanged="OnAnswerChanged" />

                <StackPanel x:Name="ActionPanel" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="CheckButton" Content="Перевірити"
                            Style="{StaticResource Button.Primary}" Click="OnCheck" />
                    <Button x:Name="DontKnowButton" Content="Не знаю"
                            Margin="8,0,0,0" Click="OnDontKnow" />
                </StackPanel>

                <!-- Result -->
                <Border x:Name="ResultPanel" Visibility="Collapsed"
                        Margin="0,12,0,0" Padding="12,10"
                        CornerRadius="{StaticResource Corner.Control}"
                        Background="{DynamicResource Brush.SurfaceAlt}">
                    <StackPanel>
                        <TextBlock x:Name="ResultStatus" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultAnswer" Style="{StaticResource Text.Prompt}"
                                   FontSize="18" Margin="0,4,0,0" />
                        <TextBlock x:Name="ResultExample" Style="{StaticResource Text.Muted}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" FontStyle="Italic"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Button x:Name="ContinueButton" Content="Далі" Visibility="Collapsed"
                        Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Right" Margin="0,10,0,0"
                        Click="OnContinue" />
            </StackPanel>

            <!-- Countdown -->
            <Border Grid.Row="2" Height="3" VerticalAlignment="Bottom"
                    CornerRadius="0,0,14,14" ClipToBounds="True"
                    Background="{DynamicResource Brush.SurfaceSunk}">
                <Rectangle x:Name="CountdownBar" HorizontalAlignment="Stretch"
                           Fill="{DynamicResource Brush.Accent}"
                           RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="CountdownScale" ScaleX="1" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>
    </Border>
</Window>
