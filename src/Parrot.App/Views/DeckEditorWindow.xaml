<Window x:Class="Parrot.App.Views.DeckEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Колода"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}">

    <StackPanel Margin="18">

        <Label Content="Назва" />
        <TextBox x:Name="NameBox" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Label Content="Мова питання" />
                <TextBox x:Name="FrontLangBox" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Label Content="Мова відповіді" />
                <TextBox x:Name="BackLangBox" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="ActiveBox" Content="Показувати картки цієї колоди" Margin="0,14,0,0" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Muted}"
                   Foreground="{DynamicResource Brush.Danger}"
                   Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Скасувати" IsCancel="True" Click="OnCancel" />
            <Button Content="Зберегти" Style="{StaticResource Button.Primary}"
                    Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
