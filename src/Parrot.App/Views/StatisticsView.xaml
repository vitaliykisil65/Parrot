<UserControl x:Class="Parrot.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Parrot.App.Localization"
             xmlns:c="clr-namespace:Parrot.App.Controls"
             xmlns:local="clr-namespace:Parrot.App.Views">

    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,24">

            <!-- Header -->
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Range7" Style="{StaticResource Segment}" GroupName="Range"
                                     Content="{l:T Stats.Range7}" Checked="OnRangeChanged" />
                        <RadioButton x:Name="Range30" Style="{StaticResource Segment}" GroupName="Range"
                                     Content="{l:T Stats.Range30}" IsChecked="True" Checked="OnRangeChanged" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="{l:T Nav.Statistics}" Style="{StaticResource Text.Title}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <Border x:Name="EmptyHint" Visibility="Collapsed" Margin="0,16,0,0" CornerRadius="12" Padding="14,10"
                    Background="{DynamicResource Brush.Active}">
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Brush.ActiveText}"
                           Text="{l:T Stats.Empty}" />
            </Border>

            <!-- Tiles -->
            <UniformGrid Columns="4" Margin="0,16,0,0">
                <Border Style="{StaticResource Tile}" Margin="0,0,7,0" Background="{DynamicResource Brush.Selection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Flame}" Size="16" Foreground="{DynamicResource Brush.ActiveIcon}" />
                            <TextBlock Text="{l:T Stats.Streak}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock x:Name="StreakValue" Style="{StaticResource Text.Metric}" />
                            <TextBlock x:Name="StreakUnit" Style="{StaticResource Text.Muted}" FontSize="14"
                                       Margin="6,0,0,6" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock x:Name="StreakNote" FontSize="12" Foreground="{DynamicResource Brush.YellowInk}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="{l:T Stats.Accuracy7}" Style="{StaticResource Text.Caption}" FontSize="13" />
                        <TextBlock x:Name="Accuracy7Value" Style="{StaticResource Text.Metric}" Margin="0,6,0,2" />
                        <TextBlock x:Name="Accuracy7Note" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="{l:T Stats.Accuracy30}" Style="{StaticResource Text.Caption}" FontSize="13" />
                        <TextBlock x:Name="Accuracy30Value" Style="{StaticResource Text.Metric}" Margin="0,6,0,2" />
                        <TextBlock x:Name="Accuracy30Note" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T Stats.Learned}" Style="{StaticResource Text.Caption}" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock x:Name="LearnedValue" Style="{StaticResource Text.Metric}" />
                            <TextBlock x:Name="LearnedOf" Style="{StaticResource Text.Muted}" FontSize="14"
                                       Margin="6,0,0,6" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <Grid Height="6" Margin="0,6,0,0">
                            <Border CornerRadius="3" Background="{DynamicResource Brush.Track}" />
                            <Border x:Name="LearnedBar" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{DynamicResource Brush.Primary}">
                                <Border.Width>
                                    <MultiBinding Converter="{x:Static local:Fraction.Converter}">
                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Activity and difficulty -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Tile}" Padding="18,16">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                        TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Brush.TextMuted}">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Primary}" />
                                <TextBlock Text="{l:T Stats.Legend.Correct}" Margin="6,0,14,0" />
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Info}" />
                                <TextBlock Text="{l:T Stats.Legend.Missed}" Margin="6,0,14,0" />
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Skipped}" />
                                <TextBlock Text="{l:T Stats.Legend.Skipped}" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{l:T Stats.Activity}" Style="{StaticResource Text.Section}" />
                        </DockPanel>

                        <ItemsControl x:Name="DailyChart" Height="150" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ToolTip}" Background="Transparent" Margin="2,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Border Height="{Binding IgnoredHeight}" Background="{DynamicResource Brush.Skipped}"
                                                    CornerRadius="3,3,0,0" Margin="0,0,0,1" />
                                            <Border Height="{Binding MissedHeight}" Background="{DynamicResource Brush.Info}" Margin="0,0,0,1" />
                                            <Border Height="{Binding CorrectHeight}" Background="{DynamicResource Brush.Primary}" />
                                            <Border Height="3" CornerRadius="2" Background="{DynamicResource Brush.Line}"
                                                    Visibility="{Binding EmptyVisibility}" />
                                        </StackPanel>
                                        <!-- Wider than its bar on purpose: the label spans neighbouring empty slots. -->
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="11" Margin="-40,0"
                                                   TextAlignment="Center" TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TodayNote" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Tile}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{l:T Stats.Difficulty}" Style="{StaticResource Text.Section}" Margin="0,0,0,14" />
                        <ItemsControl x:Name="DifficultyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12" ToolTip="{Binding ToolTip}">
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" />
                                        </DockPanel>
                                        <Grid Height="8">
                                            <Border CornerRadius="4" Background="{DynamicResource Brush.Segmented}" />
                                            <Border HorizontalAlignment="Left" CornerRadius="4" Background="{Binding Brush}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{x:Static local:Fraction.Converter}">
                                                        <Binding Path="Share" />
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="DifficultyNote" Style="{StaticResource Text.Muted}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hardest cards -->
            <Border Style="{StaticResource Tile}" Margin="0,14,0,0" Padding="18,14,18,6">
                <StackPanel>
                    <TextBlock Text="{l:T Stats.Hardest}" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                    <TextBlock x:Name="HardestEmpty" Style="{StaticResource Text.Muted}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="{l:T Stats.HardestEmpty}" />
                    <ItemsControl x:Name="HardestList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.LineFaint}" BorderThickness="0,1,0,0" Height="42">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Front}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Back}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Answers}" FontSize="13"
                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                        <Grid Grid.Column="3" Width="88" Height="6" HorizontalAlignment="Left"
                                              ToolTip="{Binding DifficultyTip}">
                                            <Border CornerRadius="3" Background="{DynamicResource Brush.Track}" />
                                            <Border CornerRadius="3" HorizontalAlignment="Left" Width="{Binding BarWidth}"
                                                    Background="{Binding BarBrush}" />
                                        </Grid>
                                        <TextBlock Grid.Column="4" Text="{Binding Accuracy}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource Brush.InfoDeep}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
