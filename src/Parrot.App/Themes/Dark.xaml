<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Accent">#5BA4FF</Color>

    <SolidColorBrush x:Key="Brush.Surface"     Color="#171C24" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"  Color="#1F262F" />
    <SolidColorBrush x:Key="Brush.SurfaceSunk" Color="#131820" />
    <SolidColorBrush x:Key="Brush.Border"      Color="#303A46" />
    <SolidColorBrush x:Key="Brush.Text"        Color="#F1F4F8" />
    <SolidColorBrush x:Key="Brush.TextMuted"   Color="#93A0B0" />
    <SolidColorBrush x:Key="Brush.Accent"      Color="#3D8BFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#5BA4FF" />
    <SolidColorBrush x:Key="Brush.AccentText"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Success"     Color="#35C88A" />
    <SolidColorBrush x:Key="Brush.Danger"      Color="#FF6B60" />
    <SolidColorBrush x:Key="Brush.Gold"        Color="#F5B324" />

</ResourceDictionary>
