<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same roles as Light.xaml; yellow stays yellow, blues get lighter as they get "stronger". -->

    <Color x:Key="Color.Shadow">#000000</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window"         Color="#0E131A" />
    <SolidColorBrush x:Key="Brush.WindowBorder"   Color="#262F3C" />
    <SolidColorBrush x:Key="Brush.Surface"        Color="#151B24" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"     Color="#1B2230" />
    <SolidColorBrush x:Key="Brush.SurfaceSunk"    Color="#111720" />
    <SolidColorBrush x:Key="Brush.Segmented"      Color="#111720" />
    <SolidColorBrush x:Key="Brush.Hover"          Color="#18202B" />
    <SolidColorBrush x:Key="Brush.HoverOverlay"   Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Brush.PressOverlay"   Color="#22FFFFFF" />
    <SolidColorBrush x:Key="Brush.Scrim"          Color="#99000000" />
    <SolidColorBrush x:Key="Brush.Toast"          Color="#EEF2F7" />
    <SolidColorBrush x:Key="Brush.ToastText"      Color="#14202E" />

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border"         Color="#2A3442" />
    <SolidColorBrush x:Key="Brush.Line"           Color="#232C38" />
    <SolidColorBrush x:Key="Brush.LineFaint"      Color="#1C232E" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text"           Color="#EEF2F7" />
    <SolidColorBrush x:Key="Brush.TextSecondary"  Color="#C3CCD8" />
    <SolidColorBrush x:Key="Brush.TextMuted"      Color="#8C98A8" />

    <!-- Yellow: actions, selection, success -->
    <SolidColorBrush x:Key="Brush.Primary"        Color="#FFC23A" />
    <SolidColorBrush x:Key="Brush.PrimaryHover"   Color="#FFD166" />
    <SolidColorBrush x:Key="Brush.PrimaryText"    Color="#14202E" />
    <SolidColorBrush x:Key="Brush.Active"         Color="#3A2E10" />
    <SolidColorBrush x:Key="Brush.ActiveText"     Color="#FFE3A0" />
    <SolidColorBrush x:Key="Brush.ActiveIcon"     Color="#FFC23A" />
    <SolidColorBrush x:Key="Brush.Selection"      Color="#2E2710" />
    <SolidColorBrush x:Key="Brush.YellowInk"      Color="#FFD166" />

    <!-- Blue: focus, links, information, "repeat later" -->
    <SolidColorBrush x:Key="Brush.Info"           Color="#5B9BFF" />
    <SolidColorBrush x:Key="Brush.InfoStrong"     Color="#7FB2FF" />
    <SolidColorBrush x:Key="Brush.InfoDeep"       Color="#A9C8FF" />
    <SolidColorBrush x:Key="Brush.InfoSoft"       Color="#1A2A45" />
    <SolidColorBrush x:Key="Brush.InfoSofter"     Color="#172235" />
    <SolidColorBrush x:Key="Brush.FocusGlow"      Color="#2E5B9BFF" />

    <!-- Difficulty scale, easy → very hard -->
    <SolidColorBrush x:Key="Brush.Difficulty0"    Color="#2A4F8F" />
    <SolidColorBrush x:Key="Brush.Difficulty1"    Color="#3D7BEA" />
    <SolidColorBrush x:Key="Brush.Difficulty2"    Color="#6FA3FF" />
    <SolidColorBrush x:Key="Brush.Difficulty3"    Color="#A9C8FF" />

    <!-- Deck dots, cycled -->
    <SolidColorBrush x:Key="Brush.Deck0"          Color="#5B9BFF" />
    <SolidColorBrush x:Key="Brush.Deck1"          Color="#FFC23A" />
    <SolidColorBrush x:Key="Brush.Deck2"          Color="#A9C8FF" />
    <SolidColorBrush x:Key="Brush.Deck3"          Color="#3D7BEA" />

    <!-- Misc -->
    <SolidColorBrush x:Key="Brush.Track"          Color="#232C38" />
    <SolidColorBrush x:Key="Brush.ToggleOff"      Color="#3A4452" />
    <SolidColorBrush x:Key="Brush.Skipped"        Color="#3A4452" />
    <SolidColorBrush x:Key="Brush.StreakEmpty"    Color="#262F3C" />
    <SolidColorBrush x:Key="Brush.Danger"         Color="#FF6B60" />
    <SolidColorBrush x:Key="Brush.DangerSoft"     Color="#3A1A1A" />
    <SolidColorBrush x:Key="Brush.CloseHover"     Color="#E5484D" />

</ResourceDictionary>
