<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Accent">#2D7DF6</Color>

    <SolidColorBrush x:Key="Brush.Surface"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"  Color="#F3F5F9" />
    <SolidColorBrush x:Key="Brush.SurfaceSunk" Color="#E8ECF3" />
    <SolidColorBrush x:Key="Brush.Border"      Color="#D6DCE6" />
    <SolidColorBrush x:Key="Brush.Text"        Color="#101820" />
    <SolidColorBrush x:Key="Brush.TextMuted"   Color="#5B6775" />
    <SolidColorBrush x:Key="Brush.Accent"      Color="#2D7DF6" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1D68DC" />
    <SolidColorBrush x:Key="Brush.AccentText"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Success"     Color="#1E9E63" />
    <SolidColorBrush x:Key="Brush.Danger"      Color="#D6463C" />
    <SolidColorBrush x:Key="Brush.Gold"        Color="#C98A10" />

</ResourceDictionary>
