<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon and Screen.WorkingArea come from Windows Forms; both are needed and
         neither has a dependency-free WPF equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Parrot</AssemblyName>
    <RootNamespace>Parrot.App</RootNamespace>
    <ApplicationIcon>..\..\assets\parrot.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Parrot</Product>
    <Version>0.1.0</Version>
    <Company>Vitalii Kysil</Company>
    <Authors>Vitalii Kysil</Authors>
    <Copyright>© 2026 Vitalii Kysil</Copyright>
    <Description>Parrot — вивчення слів у фоні</Description>
    <!-- owner/repo on GitHub whose releases carry Parrot-Setup-*.exe. Empty turns update
         checks off; PARROT_UPDATE_URL overrides it for testing. -->
    <UpdateRepository>vitaliykisil65/Parrot</UpdateRepository>
    <!-- Strings.resx is Ukrainian; translations ship as satellite assemblies next to it. -->
    <NeutralLanguage>uk</NeutralLanguage>
    <!-- The Windows Forms analyzer wants DPI awareness set through its own API, but the
         manifest entry is what WPF reads; the tray icon is the only Forms surface here. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms brings System.Windows.Forms and System.Drawing in as implicit usings,
         which makes TextBox, CheckBox, Brush and Application ambiguous against their WPF
         namesakes. The few Forms types this app needs are reached through aliases instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parrot.Core\Parrot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\parrot.ico" Link="parrot.ico" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The starter word list is for development only: released builds start with an empty
         dictionary. -p:IncludeStarterDeck=true puts it into any build. -->
    <IncludeStarterDeck Condition="'$(IncludeStarterDeck)' == ''">$([System.String]::Equals('$(Configuration)', 'Debug'))</IncludeStarterDeck>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="DevData\StarterDeck.csv" />
    <EmbeddedResource Include="DevData\StarterDeck.csv" LogicalName="Parrot.App.DevData.StarterDeck.csv" Condition="'$(IncludeStarterDeck)' == 'true'" />
  </ItemGroup>

</Project>
